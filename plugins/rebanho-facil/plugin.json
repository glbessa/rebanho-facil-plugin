{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "rebanho-facil",
  "version": "1.0.2",
  "description": "Gestão pecuária do Rebanho Fácil: animais, pesagens, sanidade, reprodução, pastagens e financeiro da fazenda.",
  "author": {
    "name": "Zero Um Labs",
    "email": "suporte@rebanhofacil.com"
  },
  "homepage": "https://rebanhofacil.com",
  "repository": "https://github.com/glbessa/rebanho-facil-plugin",
  "license": "MIT",
  "keywords": [
    "pecuaria",
    "rebanho",
    "fazenda",
    "gado",
    "mcp"
  ],
  "extensions": {
    "com.openai": {
      "interface": {
        "displayName": "Rebanho Fácil",
        "shortDescription": "Gestão do rebanho por conversa",
        "longDescription": "Conecta sua conta do Rebanho Fácil. Cadastre animais, lance pesagens, medicamentos e partos, acompanhe GPD, carências e vacinas pendentes, mova lotes entre campos e registre receitas e despesas da fazenda.",
        "developerName": "Zero Um Labs",
        "category": "Productivity",
        "capabilities": [
          "Read",
          "Write"
        ],
        "websiteURL": "https://rebanhofacil.com",
        "privacyPolicyURL": "https://app.rebanhofacil.com/privacidade",
        "termsOfServiceURL": "https://app.rebanhofacil.com/termos",
        "composerIcon": "./assets/icon.png",
        "logo": "./assets/icon.png",
        "brandColor": "#2D5016"
      }
    }
  }
}
